fit_content = true
text = "[b]Bureau of Infinity[/b]\n\nProjeto UI-only em Godot 4.3+.\nTodos os visuais usam apenas Control nodes e estilos nativos do motor.\n\nEstrutura pronta para expansão de conteúdo incremental."
